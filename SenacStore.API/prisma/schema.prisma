// O banco é criado pelo script database/script.sql, então este projeto não usa migrations.
// Os nomes com @map ligam os campos em camelCase às colunas do MySQL.
// Os IDs são GUIDs gravados como texto em CHAR(36), gerados pelo Prisma com uuid().

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model TipoUsuario {
  id       String    @id @default(uuid()) @map("Id") @db.Char(36)
  nome     String    @map("Nome") @db.VarChar(100)
  usuarios Usuario[]

  @@map("TipoUsuario")
}

model Usuario {
  id            String      @id @default(uuid()) @map("Id") @db.Char(36)
  nome          String      @map("Nome") @db.VarChar(150)
  email         String      @unique(map: "UQ_Usuario_Email") @map("Email") @db.VarChar(150)
  senha         String      @map("Senha") @db.VarChar(200)
  tipoUsuarioId String      @map("TipoUsuarioId") @db.Char(36)
  tipoUsuario   TipoUsuario @relation(fields: [tipoUsuarioId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_Usuario_TipoUsuario")

  @@index([tipoUsuarioId], map: "FK_Usuario_TipoUsuario")
  @@map("Usuario")
}

model Categoria {
  id       String    @id @default(uuid()) @map("Id") @db.Char(36)
  nome     String    @map("Nome") @db.VarChar(120)
  produtos Produto[]

  @@map("Categoria")
}

model Produto {
  id          String    @id @default(uuid()) @map("Id") @db.Char(36)
  nome        String    @map("Nome") @db.VarChar(150)
  preco       Decimal   @map("Preco") @db.Decimal(10, 2)
  categoriaId String    @map("CategoriaId") @db.Char(36)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_Produto_Categoria")

  @@index([categoriaId], map: "FK_Produto_Categoria")
  @@map("Produto")
}
