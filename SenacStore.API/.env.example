# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.
# No Azure, estes valores são cadastrados nas variáveis de ambiente do App Service.

# Texto longo e aleatório que assina os tokens. Para gerar um:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# MySQL local
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_DB=SenacStore
DATABASE_USER=
# Pode ficar vazia se o usuário não tiver senha (como o root do XAMPP).
# Use aspas se a senha tiver # (sem aspas, o que vem depois dele é ignorado)
DATABASE_PASS=""

# false no MySQL local. No Azure Database for MySQL, use true.
DATABASE_SSL=false

# Ao iniciar na sua máquina, a API abre o Swagger no navegador. Use false para desligar.
# No Azure isso nunca acontece.
ABRIR_NAVEGADOR=true
